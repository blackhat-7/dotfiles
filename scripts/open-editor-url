#!/usr/bin/env python3
"""Open Kitty file links in $EDITOR inside a tmux vertical split."""

from __future__ import annotations

import os
import shlex
import shutil
import subprocess
import sys
from urllib.parse import unquote, urlparse


def add_shell_path() -> None:
    home = os.environ.get("HOME", "")
    user = os.environ.get("USER", "")
    paths = [
        f"{home}/.local/bin",
        f"{home}/.nix-profile/bin",
        f"/etc/profiles/per-user/{user}/bin",
        "/run/current-system/sw/bin",
        "/opt/homebrew/bin",
        "/usr/local/bin",
        "/usr/bin",
        "/bin",
        os.environ.get("PATH", ""),
    ]
    os.environ["PATH"] = os.pathsep.join(p for p in paths if p)


def parse_url(raw: str) -> tuple[str, str | None, str | None]:
    url = urlparse(raw)
    if not ((url.scheme == "nvim" and url.netloc == "file") or url.scheme == "file"):
        raise ValueError(f"unsupported URL: {raw}")

    path = unquote(url.path)
    if url.fragment.isdigit():
        return path, url.fragment, None

    parts = path.rsplit(":", 2)
    if len(parts) == 3 and parts[1].isdigit() and parts[2].isdigit():
        return parts[0], parts[1], parts[2]
    if len(parts) >= 2 and parts[-1].isdigit():
        return ":".join(parts[:-1]), parts[-1], None
    return path, None, None


def editor_cmd(path: str, line: str | None, col: str | None) -> list[str]:
    cmd = shlex.split(os.environ.get("EDITOR", "nvim")) or ["nvim"]
    if os.path.basename(cmd[0]) == "nvim":
        cmd += ["--cmd", "lua vim.deprecate=function() end"]
    if line:
        cmd.append(f"+{line}")
    if col:
        cmd.append(f"+normal! {col}|")
    return cmd + ["--", path]


def active_pane(tmux: str) -> str | None:
    if pane := os.environ.get("TMUX_PANE"):
        return pane

    clients = subprocess.run(
        [tmux, "list-clients", "-F", "#{client_activity}\t#{client_name}"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if clients.returncode != 0 or not clients.stdout.strip():
        return None

    client = max((line.split("\t", 1) for line in clients.stdout.splitlines()), key=lambda p: int(p[0]))[1]
    pane = subprocess.run(
        [tmux, "display-message", "-c", client, "-p", "#{pane_id}"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    return pane.stdout.strip() if pane.returncode == 0 else None


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: open-editor-url URL", file=sys.stderr)
        return 2

    add_shell_path()
    tmux = shutil.which("tmux")
    pane = active_pane(tmux) if tmux else None
    if not tmux or not pane:
        print("tmux pane not found", file=sys.stderr)
        return 1

    try:
        cmd = editor_cmd(*parse_url(sys.argv[1]))
    except ValueError as exc:
        print(exc, file=sys.stderr)
        return 2

    return subprocess.run([
        tmux,
        "split-window",
        "-h",
        "-p", "40",
        "-t", pane,
        "-c", "#{pane_current_path}",
        "-e", f"PATH={os.environ['PATH']}",
        shlex.join(cmd),
    ]).returncode


if __name__ == "__main__":
    raise SystemExit(main())
