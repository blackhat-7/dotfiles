#!/usr/bin/env bash
# Step the focused monitor's brightness over DDC/CI, via the DMS OSD.
# Usage: monitor-brightness up|down [step]

set -euo pipefail

step=${2:-5}
cache="${XDG_RUNTIME_DIR:-/tmp}/monitor-brightness.map"

# /dev/i2c-N numbering shifts across boots, but the adapter's name does not,
# so cache "<connector>\t<adapter name>" per monitor and resolve the name
# back to a number on each run. Falling back to `ddcutil detect` is correct
# but takes ~4s, too slow for a keypress.
bus_for_name() {
  local dev
  for dev in /sys/bus/i2c/devices/i2c-*; do
    if [[ $(< "$dev/name") == "$1" ]]; then
      echo "${dev##*/i2c-}"
      return 0
    fi
  done
  return 1
}

build_cache() {
  ddcutil detect --brief | awk -v RS= '
    match($0, /I2C bus:[^\n]*\/dev\/i2c-[0-9]+/) {
      bus = substr($0, RSTART, RLENGTH); sub(/.*i2c-/, "", bus)
      if (match($0, /DRM connector:[^\n]*card[0-9]+-[^ \n]+/)) {
        conn = substr($0, RSTART, RLENGTH); sub(/.*card[0-9]+-/, "", conn)
        name = ""
        while ((getline line < ("/sys/bus/i2c/devices/i2c-" bus "/name")) > 0) name = line
        print conn "\t" name
      }
    }' > "$cache"
}

focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')

bus=""
if [[ -r $cache ]]; then
  name=$(awk -F'\t' -v c="$focused" '$1 == c { print $2 }' "$cache")
  [[ -n $name ]] && bus=$(bus_for_name "$name" || true)
fi

if [[ -z $bus ]]; then
  build_cache
  name=$(awk -F'\t' -v c="$focused" '$1 == c { print $2 }' "$cache")
  [[ -n $name ]] && bus=$(bus_for_name "$name" || true)
  if [[ -z $bus ]]; then
    notify-send -u critical "Brightness" "No DDC/CI monitor found for $focused"
    exit 1
  fi
fi

case ${1:-} in
  up)   dms ipc call brightness increment "$step" "ddc:i2c-$bus" ;;
  down) dms ipc call brightness decrement "$step" "ddc:i2c-$bus" ;;
  *)    echo "usage: ${0##*/} up|down [step]" >&2; exit 2 ;;
esac
