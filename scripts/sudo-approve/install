#!/bin/bash
# Installs sudo-approve: root-owned helper and config, a PAM line before the password prompt,
# and no reuse of a past approval. Usage: sudo ./install [CONF]  |  sudo ./install --uninstall
# CONF holds NTFY_URL, HOST_TOKEN and APPROVER_TOKEN; it is moved, so no user-readable copy stays.
set -euo pipefail
[ "$EUID" = 0 ] || { echo 'run with sudo' >&2; exit 1; }
dir=$(dirname "$(readlink -f "$0")")
pam=/etc/pam.d/sudo
# seteuid: pam_exec would otherwise run it as the calling user, who must not read the tokens.
line='auth sufficient pam_exec.so quiet seteuid /usr/local/sbin/sudo-approve'

if [ "${1:-}" = --uninstall ]; then
  sed -i "\#$line#d" "$pam"
  rm -f /usr/local/sbin/sudo-approve /etc/sudo-approve.conf /etc/sudoers.d/sudo-approve
  exit
fi

# CONF is needed only the first time; rerun without it to update the helper.
if [ -n "${1:-}" ]; then
  install -o root -g root -m 0600 "$1" /etc/sudo-approve.conf
  rm -f "$1"
fi
[ -f /etc/sudo-approve.conf ] || { echo 'usage: sudo ./install CONF' >&2; exit 1; }
install -o root -g root -m 0755 "$dir/sudo-approve" /usr/local/sbin/sudo-approve
# Otherwise one approved sudo lets the same shell run more sudo commands for 5 minutes unasked.
rules=$(mktemp)
echo 'Defaults timestamp_timeout=0' > "$rules"
visudo -cqf "$rules"
install -o root -g root -m 0440 "$rules" /etc/sudoers.d/sudo-approve
rm -f "$rules"
grep -qxF "$line" "$pam" || sed -i "/^#%PAM-1.0/a $line" "$pam"
echo 'Installed. Deny or no answer in 60 s falls back to the password prompt.'
