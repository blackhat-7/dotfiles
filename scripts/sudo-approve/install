#!/bin/bash
# One-time setup next to the Nix-managed helper at /etc/sudo-approve (nix/linux/default.nix):
# the root-only config, no reuse of a past approval, and one PAM line in Arch's /etc/pam.d/sudo.
# Usage: sudo ./install [CONF]  |  sudo ./install --uninstall
# CONF holds NTFY_URL, HOST_TOKEN and APPROVER_TOKEN; it is moved, so no user-readable copy stays.
set -euo pipefail
[ "$EUID" = 0 ] || { echo 'run with sudo' >&2; exit 1; }
pam=/etc/pam.d/sudo
# seteuid: pam_exec would otherwise run it as the calling user, who must not read the tokens.
line='auth sufficient pam_exec.so quiet seteuid /etc/sudo-approve'

# Also drops the line of the first version, which ran /usr/local/sbin/sudo-approve.
sed -i '\#pam_exec.so quiet seteuid .*sudo-approve$#d' "$pam"
rm -f /usr/local/sbin/sudo-approve
if [ "${1:-}" = --uninstall ]; then
  rm -f /etc/sudo-approve.conf /etc/sudoers.d/sudo-approve
  exit
fi

if [ -n "${1:-}" ]; then
  install -o root -g root -m 0600 "$1" /etc/sudo-approve.conf
  rm -f "$1"
fi
[ -f /etc/sudo-approve.conf ] || { echo 'usage: sudo ./install CONF' >&2; exit 1; }
[ -x /etc/sudo-approve ] || { echo 'run `just linux` first: it installs /etc/sudo-approve' >&2; exit 1; }
# Otherwise one approved sudo lets the same shell run more sudo commands for 5 minutes unasked.
rules=$(mktemp)
echo 'Defaults timestamp_timeout=0' > "$rules"
visudo -cqf "$rules"
install -o root -g root -m 0440 "$rules" /etc/sudoers.d/sudo-approve
rm -f "$rules"
sed -i "/^#%PAM-1.0/a $line" "$pam"
echo 'Installed. Deny or no answer in 60 s falls back to the password prompt.'
