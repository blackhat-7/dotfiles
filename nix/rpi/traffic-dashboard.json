{
  "uid": "sedder-traffic",
  "title": "Sedder traffic",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Downloaded per device",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(sum by (name) (sum_over_time(tplink_device_download_bytes_per_second[$__range])) * 15)",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 2,
      "title": "Uploaded per device",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(sum by (name) (sum_over_time(tplink_device_upload_bytes_per_second[$__range])) * 15)",
          "legendFormat": "{{name}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "id": 3,
      "title": "Download speed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (tplink_device_download_bytes_per_second)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Upload speed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (tplink_device_upload_bytes_per_second)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Daily download",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (sum_over_time(tplink_device_download_bytes_per_second[1d])) * 15",
          "legendFormat": "{{name}}",
          "refId": "A",
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Daily upload",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (sum_over_time(tplink_device_upload_bytes_per_second[1d])) * 15",
          "legendFormat": "{{name}}",
          "refId": "A",
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Top sites (last 1000 lookups)",
      "type": "table",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "adguard"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "adguard"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/control/querylog",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "limit",
                "value": "1000"
              },
              {
                "key": "search",
                "value": "$device"
              }
            ]
          },
          "root_selector": "data",
          "columns": [
            {
              "selector": "time",
              "text": "Time",
              "type": "timestamp"
            },
            {
              "selector": "client",
              "text": "Device",
              "type": "string"
            },
            {
              "selector": "question.name",
              "text": "Domain",
              "type": "string"
            }
          ],
          "filterExpression": "\"$device\" == \"\" || Device == \"$device\""
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "Domain": {
                "aggregations": [],
                "operation": "groupby"
              },
              "Time": {
                "aggregations": [
                  "count"
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Time (count)": "Lookups"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Lookups",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Recent lookups",
      "type": "table",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "adguard"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "adguard"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/control/querylog",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "limit",
                "value": "1000"
              },
              {
                "key": "search",
                "value": "$device"
              }
            ]
          },
          "root_selector": "data",
          "columns": [
            {
              "selector": "time",
              "text": "Time",
              "type": "timestamp"
            },
            {
              "selector": "client",
              "text": "Device",
              "type": "string"
            },
            {
              "selector": "question.name",
              "text": "Domain",
              "type": "string"
            }
          ],
          "filterExpression": "\"$device\" == \"\" || Device == \"$device\""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device (sites)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "tplink_device_download_bytes_per_second",
          "refId": "device"
        },
        "definition": "tplink_device_download_bytes_per_second",
        "regex": "/ip=\"(?<value>[^\"]+)\".*name=\"(?<text>[^\"]+)\"/",
        "refresh": 2,
        "includeAll": true,
        "allValue": "",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}